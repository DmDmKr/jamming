# Spotify API Configuration
# Get your credentials from: https://developer.spotify.com/dashboard

# Your Spotify App Client ID
VITE_SPOTIFY_CLIENT_ID=your_client_id_here

# Your Spotify User ID (found in your Spotify account settings)
VITE_SPOTIFY_USER_ID=your_user_id_here

# Redirect URI - must match what you configured in Spotify Developer Dashboard
# IMPORTANT: Use http://127.0.0.1:3000/ (not localhost) to avoid Spotify's "insecure redirect" error
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/
